# Multi-turn evaluator backend. Copy to backend/.env (git-ignored) and
# fill in the values. Real environment variables take precedence over this file.

# --- Server -------------------------------------------------------------------
PORT=8080
DB_PATH=evaluator.db
# Browser origin allowed to call the API (frontend dev server); empty = same origin only
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Evaluated agent ------------------------------------------------------------
# Required. Name of an adapter registered in the program you run
# (cmd/server bundles fake and httpagent; cmd/hiringlab adds hiringlab; your own main adds yours).
# There is no default: the evaluator does not assume an agent.
# fake: offline demo, no credentials needed
AGENT=fake

# Per-adapter settings (only those of the selected AGENT are read).
# httpagent: any REST agent, described in YAML (see examples/httpagent/httpchat.agent.yaml)
# AGENT=httpagent
# HTTPAGENT_CONFIG=examples/httpagent/httpchat.agent.yaml
# plus the variables that file references as ${NAME}
# hiringlab: see adapters/hiringlab/README.md (run it with ./cmd/hiringlab)
# AGENT=hiringlab
# HIRING_LAB_BASE_URL=https://<host>/api/private/projects/<project id>
# HIRING_LAB_PROJECT_KEY=<project api key>

# --- LLM judge (llm_judge and context_retention criteria) -----------------------
# openai-compatible (default): any provider or gateway implementing the
#   Chat Completions protocol (POST {JUDGE_BASE_URL}/chat/completions, Bearer token)
# anthropic: Anthropic Messages API
# fake: deterministic judge and analyzer, no LLM calls (offline demos, UI tests)
# The same provider is used by the LLM criteria and by "Analyze" (second opinion).
JUDGE_PROVIDER=openai-compatible
# Required for openai-compatible: provider base URL including the version segment
# (e.g. .../v1). Optional for anthropic (defaults to https://api.anthropic.com).
JUDGE_BASE_URL=<openai-compatible base url>
JUDGE_API_KEY=<llm provider api key>
# openai-compatible: defaults to gpt-5.4-mini (low-cost mini model) when empty.
# anthropic: required (no implicit default, to never pick an expensive model by accident).
# Avoid gpt-6-luna: it is the evaluated agent's own model (self-evaluation bias).
JUDGE_MODEL=gpt-5.4-mini
# openai-compatible only: json_schema (default) | json_object | text (for providers without structured output)
JUDGE_RESPONSE_FORMAT=json_schema
# anthropic only: low | medium | high (default) | xhigh | max
# JUDGE_EFFORT=high
# Who is evaluated, named in the judge and Analyze prompts (default: "an AI assistant")
JUDGE_AGENT_DESCRIPTION=an AI assistant

# --- Execution --------------------------------------------------------------------
# Global worker pool: scenarios running at once across all evaluations
WORKERS=4
# Scenarios in flight per evaluation when the request does not set concurrency
DEFAULT_CONCURRENCY=2
# Minimum turns per scenario, enforced on every suite import (suites cannot override it)
SUITE_MIN_TURNS=3
